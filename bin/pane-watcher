#!/bin/bash
# pane-watcher <run-id> — 对话 pane：渲染 opencode 会话的**真实对话**。
#
# 数据源：~/.local/share/opencode/opencode.db 的 session_message 表
#   user / assistant(text|reasoning|tool) / system / idle / compaction
# 每秒重绘，始终显示最近一屏；run 结束后渲染终态并退出（pane 由 monitor 关闭）。
# 同时输出纯文本快照 state/chat-<id>.txt，供测试和外部查看。

set -uo pipefail
# -H <home>：显式指定 GM_HOME（surface 环境变量在快速分屏时可能被 Ghostty 丢弃）
GM_HOME_ARG=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -H) GM_HOME_ARG=${2:-}; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
[[ -n $GM_HOME_ARG ]] && export GM_HOME=$GM_HOME_ARG
source "$(cd "$(dirname "$0")" && pwd)/gm-lib.sh"

ID=${ARGS[0]:-}
[[ -n $ID ]] || { echo "pane-watcher: 缺少 run-id" >&2; exit 2; }

REG="$GM_RUNS/$ID.json"
HB="$GM_STATE/hb/$ID"
SNAP="$GM_STATE/chat-$ID.txt"
SIDFILE="$GM_STATE/session-$ID"
BUF="$GM_STATE/.chat.$$"
HEADF="$GM_STATE/.chat-head.$$"
BODYF="$GM_STATE/.chat-body.$$"

TOK=""; TOK_AT=0; MSGS=""
cleanup_tmp() { rm -f "$BUF" "$HEADF" "$BODYF"; }
trap cleanup_tmp EXIT

printf '\033]0;%s · 对话\033\\' "$ID"

# ---------- 渲染小工具 ----------
emit_text() { # label color text
  local label=$1 color=$2 text=$3 w=$((GM_TERM_COLS - 4)) first=1 ln
  (( w < 24 )) && w=24
  [[ -z $text ]] && return 0
  while IFS= read -r ln; do
    if (( first )); then
      printf '\033[%sm▌%s\033[0m %s\n' "$color" "$label" "$ln"
      first=0
    else
      printf '  %s\n' "$ln"
    fi
  done < <(printf '%s\n' "$text" | fold -s -w "$w")
  printf '\n'
}

emit_dim() { # text
  local w=$((GM_TERM_COLS - 4)) ln
  (( w < 24 )) && w=24
  printf '%s\n' "$1" | fold -s -w "$w" | while IFS= read -r ln; do
    printf '\033[2m  %s\033[0m\n' "$ln"
  done
}

emit_tool() { # name status arg output
  local name=$1 status=$2 arg=$3 out=$4 w=$((GM_TERM_COLS - 8)) ln first=1
  (( w < 20 )) && w=20
  printf '\033[1;33m⚙ %s\033[0m \033[2m[%s]\033[0m ' "${name:-tool}" "${status:-?}"
  printf '%s\n' "${arg:-}" | fold -s -w "$w" | while IFS= read -r ln; do
    if (( first )); then printf '%s\n' "$ln"; first=0; else printf '  %s\n' "$ln"; fi
  done
  if [[ -n ${out:-} ]]; then
    printf '%s\n' "$out" | fold -s -w "$((GM_TERM_COLS - 6))" | while IFS= read -r ln; do
      printf '\033[2m  ⎿ %s\033[0m\n' "$ln"
    done
  fi
  printf '\n'
}

# ---------- 会话消息 → 角色行 ----------
fetch_messages() { # sid
  local sid=$1 esc db=$GM_OPENCODE_DB
  esc=${sid//\'/\'\'}
  sqlite3 -readonly "$db" \
    "select json_object('seq',seq,'type',type,'data',json(data))
       from session_message
      where session_id='$esc'
      order by seq desc limit 40;" 2>/dev/null
}

render_messages() { # sid
  local sid=$1 esc db=$GM_OPENCODE_DB
  esc=${sid//\'/\'\'}
  fetch_messages "$sid" | jq -s -r '
    reverse[] as $m | ($m.data // {}) as $d |
    if $m.type == "user" then
      (($d.text // "") | gsub("\t"; "  ") | split("\n")[]) | "U\t" + .
    elif $m.type == "assistant" then
      (($d.content // [])[]) as $p |
      if $p.type == "text" then
        (($p.text // "") | gsub("\t"; "  ") | split("\n")[]) | "A\t" + .
      elif $p.type == "reasoning" then
        "R\t" + (($p.text // "") | gsub("\t"; " ") | gsub("\\s+"; " ") | .[0:600])
      elif $p.type == "tool" then
        (($p.state.input.command // $p.state.input.filePath // $p.state.input.pattern
          // $p.state.input.url // ($p.state.input | tostring))
          | tostring | gsub("\t"; " ") | gsub("\n"; " ") | .[0:260]) as $arg |
        (($p.state.content // []) | map(select(.type == "text") | (.text // ""))
          | join(" ⏎ ") | gsub("\t"; " ") | gsub("\n"; " ⏎ ") | .[0:400]) as $out |
        "T\t" + ($p.name // "tool") + "\t" + ($p.state.status // "?") + "\t" + $arg + "\t" + $out
      else empty end
    elif $m.type == "idle" then
      "I\t" + ($d.outcome // "")
    elif $m.type == "system" then
      "S\t" + (($d.text // ($d | tostring)) | tostring | .[0:300])
    elif $m.type == "compaction" then
      "C\t" + (($d | tostring) | .[0:200])
    elif $m.type == "synthetic" then
      "S\t" + (($d | tostring) | .[0:300])
    else empty end
  ' 2>/dev/null
}

# ---------- 主渲染 ----------
render() { # status model card elapsed active sid code
  local status=$1 model=$2 card=$3 elapsed=$4 active=$5 sid=$6 code=$7
  local state_text color line

  if (( active )); then
    state_text="运行中"; color='1;32'
  elif [[ $status == done ]]; then
    state_text="已完成"; color='1;36'
  else
    state_text="失败($status)"; color='1;31'
  fi

  : > "$HEADF"
  printf '\033[1;36m▌%s\033[0m \033[2m%s\033[0m\n' "$(gm_ell "$card" $((GM_TERM_COLS - 8)))" "$ID" >> "$HEADF"
  if (( GM_TERM_COLS >= 55 )); then
    if (( active )); then
      printf '\033[%sm● %s\033[0m · %s · %s · tok %s · 消息 %s\n' \
        "$color" "$state_text" "$(gm_ell "$model" 26)" "$(gm_fmt_dur "$elapsed")" "${TOK:-—}" "${MSGS:-—}" >> "$HEADF"
    else
      printf '\033[%sm%s\033[0m · %s · 用时 %s · exit %s · tok %s · 消息 %s\n' \
        "$color" "$state_text" "$(gm_ell "$model" 22)" "$(gm_fmt_dur "$elapsed")" "${code:--}" "${TOK:-—}" "${MSGS:-—}" >> "$HEADF"
    fi
  else
    if (( active )); then
      printf '\033[%sm● %s\033[0m · %s · tok %s\n' \
        "$color" "$state_text" "$(gm_fmt_dur "$elapsed")" "${TOK:-—}" >> "$HEADF"
    else
      printf '\033[%sm%s\033[0m · 用时 %s · exit %s\n' \
        "$color" "$state_text" "$(gm_fmt_dur "$elapsed")" "${code:--}" >> "$HEADF"
    fi
  fi
  printf '\033[2m%s\033[0m\n' "$(printf '─%.0s' $(seq 1 "$GM_TERM_COLS"))" >> "$HEADF"

  : > "$BODYF"
  if [[ -n $sid ]]; then
    render_messages "$sid" | while IFS=$'\t' read -r kind a b c d; do
      case $kind in
        U) emit_text "用户" "1;34" "$a" ;;
        A) emit_text "助手" "1;32" "$a" ;;
        R) emit_text "思考" "2" "$a" ;;
        T) emit_tool "$a" "$b" "$c" "$d" ;;
        I) emit_dim "… 等待（${a:-idle}）" ;;
        S) emit_dim "$a" ;;
        C) emit_dim "（上下文压缩）$a" ;;
        *) : ;;
      esac
    done >> "$BODYF"
  fi

  : > "$BUF"
  cat "$HEADF" >> "$BUF"
  if [[ -s $BODYF ]]; then
    tail -n "$BODY_LINES" "$BODYF" >> "$BUF"
  else
    # 会话尚未建立：退回原始日志，避免 pane 空白
    {
      printf '\033[2m  等待 opencode 会话建立…（日志实时预览）\033[0m\n\n'
      if [[ -f $LOG ]]; then tail -n "$((BODY_LINES - 2))" "$LOG"; fi
    } >> "$BUF"
  fi
  printf '\033[2m%s\033[0m\n' "$(printf '─%.0s' $(seq 1 "$GM_TERM_COLS"))" >> "$BUF"
  if (( active )); then
    printf '\033[2m跟随中 · %s · %s\033[0m' "$(date '+%H:%M:%S')" "$([[ -n $sid ]] && echo "ses ${sid: -8}" || echo '无会话')" >> "$BUF"
  else
    printf '\033[2mrun 已结束，pane 即将关闭 · %s\033[0m' "$(date '+%H:%M:%S')" >> "$BUF"
  fi

  printf '\033[H\033[2J'
  cat "$BUF"
  sed $'s/\033\\[[0-9;]*m//g; s/\033\\][^\a]*\a//g' "$BUF" > "$SNAP.tmp.$$" 2>/dev/null \
    && mv -f "$SNAP.tmp.$$" "$SNAP" 2>/dev/null
}

# ---------- 循环 ----------
pty_alive() { stty size </dev/tty >/dev/null 2>&1; }

while :; do
  if [[ ! -f $REG ]]; then
    printf '\033[H\033[2J该 run 已从注册表移除（%s），pane 即将关闭。\n' "$ID"
    sleep 1
    exit 0
  fi

  IFS=$'\t' read -r status model card logf pid started cwd code <<<"$(
    jq -r '[.status // "unknown", .model // "-", .card // .id // "-",
            .log // "-", (.pid // 0 | tostring), (.started // 0 | tostring),
            .cwd // "", (.exit // 0 | tostring)] | @tsv' "$REG" 2>/dev/null
  )"
  LOG=${logf:-}
  started=${started:-0}; pid=${pid:-0}; code=${code:-0}
  gm_term_size
  BODY_LINES=$((GM_TERM_LINES - 5))
  (( BODY_LINES < 4 )) && BODY_LINES=4

  active=0
  local sid_db
  sid_db=$(gm_run_get "$REG" .session "" 2>/dev/null)
  if [[ -n $sid_db && "$pid" == 0 ]]; then
    # DB 自动发现模式：会话 150 秒内有更新 = 运行中
    local fresh
    fresh=$(sqlite3 -readonly "$GM_OPENCODE_DB" "select case when time_updated >= $(( ($(gm_now) - 150) * 1000 )) then 1 else 0 end from session_v2 where id='$sid_db';" 2>/dev/null)
    [[ $fresh == 1 ]] && active=1
  elif [[ $status == running ]] && gm_alive "$pid"; then
    active=1
  fi

  # session id：先看缓存文件，再按 cwd+时间解析
  sid=""
  [[ -s $SIDFILE ]] && sid=$(cat "$SIDFILE" 2>/dev/null)
  if [[ -z $sid ]]; then
    sid=$(gm_session_for_registry "$REG" 2>/dev/null) || sid=""
  fi

  # token / 消息数：每 5 秒刷新一次
  now=$(gm_now)
  if (( now - TOK_AT >= 5 )); then
    TOK_AT=$now
    if [[ -n $sid ]]; then
      if t=$(gm_session_tokens_sid "$sid"); then TOK=$(gm_fmt_tokens "$t"); else TOK=""; fi
      esc=${sid//\'/\'\'}
      MSGS=$(sqlite3 -readonly "$GM_OPENCODE_DB" "select count(*) from session_message where session_id='$esc';" 2>/dev/null)
    else
      TOK=""; MSGS=""
    fi
  fi

  elapsed=$(( $(gm_now) - started )); (( elapsed < 0 )) && elapsed=0
  render "$status" "$model" "$card" "$elapsed" "$active" "$sid" "$code"

  # 供验收测试断言（pane 实际尺寸）
  printf '%s %s\n' "$GM_TERM_COLS" "$GM_TERM_LINES" > "$GM_STATE/size-$ID.txt" 2>/dev/null

  pty_alive || exit 0                     # pane 已被关闭 → 自杀
  if (( active )); then
    touch "$HB"
    sleep 1
  else
    rm -f "$HB"
    sleep 0.3
    exit 0
  fi
done

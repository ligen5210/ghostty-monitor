#!/bin/bash
# pane-watcher <run-id> — 对话 pane：渲染 opencode 会话的真实对话与思考流。
#
# 数据源：session_message 表（user/assistant(text|reasoning|tool)/system/idle）
# 每秒无闪烁重绘（逐行刷新，无全屏白闪）；run 结束渲染终态后退出。
# 纯文本快照写 state/chat-<id>.txt。

set -o pipefail
GM_HOME_ARG=""
ARGS=()
while [[ $# -gt 0 ]]; do
  case $1 in
    -H) GM_HOME_ARG=${2:-}; shift 2 ;;
    *) ARGS+=("$1"); shift ;;
  esac
done
[[ -n $GM_HOME_ARG ]] && export GM_HOME=$GM_HOME_ARG
source "$(cd "$(dirname "$0")" && pwd)/gm-lib.sh"

ID=${ARGS[0]:-}
[[ -n $ID ]] || { echo "pane-watcher: 缺少 run-id" >&2; exit 2; }

REG="$GM_RUNS/$ID.json"
HB="$GM_STATE/hb/$ID"
SNAP="$GM_STATE/chat-$ID.txt"
SIDFILE="$GM_STATE/session-$ID"
BUF="$GM_STATE/.chat.$$"
HEADF="$GM_STATE/.chat-head.$$"
BODYF="$GM_STATE/.chat-body.$$"

TOK=""; TOK_AT=0; MSGS=""
cleanup_tmp() { rm -f "$BUF" "$HEADF" "$BODYF"; }
trap cleanup_tmp EXIT

pty_alive() { stty size </dev/tty >/dev/tty >/dev/null 2>&1; }

# 按显示宽度折行（CJK=2 格）；fold 只按字符数，会低估中文导致换行溢出
wrap_lines() { # width
  python3 -c '
import sys, unicodedata
w = int(sys.argv[1])
def dw(s):
    t = 0
    for c in s:
        o = ord(c)
        if (11904 <= o <= 12350) or (12353 <= o <= 13311) or (13312 <= o <= 19903) or (19968 <= o <= 40959) or (63744 <= o <= 64255) or (65280 <= o <= 65376) or (65504 <= o <= 65510) or (4352 <= o <= 4447) or o >= 131072:
            t += 2
    return t
for line in sys.stdin:
    line = line.rstrip("\n")
    cur = ""
    for ch in line:
        if dw(cur + ch) > w and cur:
            print(cur); cur = ch
        else:
            cur += ch
    print(cur)
' "$1"
}


emit_text() { # label color text（多行文本，首行带标签）
  local label=$1 color=$2 text=$3 w=$((GM_TERM_COLS - 8)) first=1 ln
  (( w < 24 )) && w=24
  [[ -z $text ]] && return 0
  while IFS= read -r ln; do
    if (( first )); then
      printf '\033[%sm▌%s\033[0m %s\n' "$color" "$label" "$ln"
      first=0
    else
      printf '  %s\n' "$ln"
    fi
  done < <(printf '%s\n' "$text" | wrap_lines "$w")
  printf '\n'
}

emit_dim() {
  local w=$((GM_TERM_COLS - 6)) ln
  (( w < 24 )) && w=24
  printf '%s\n' "$1" | wrap_lines "$w" | while IFS= read -r ln; do
    printf '\033[2m  %s\033[0m\n' "$ln"
  done
}

emit_tool() { # name status arg output
  local name=$1 status=$2 arg=$3 out=$4 w=$((GM_TERM_COLS - 10)) ln first=1
  (( w < 20 )) && w=20
  printf '\033[1;33m⚙ %s\033[0m \033[2m[%s]\033[0m ' "${name:-tool}" "${status:-?}"
  printf '%s\n' "${arg:-}" | wrap_lines "$w" | while IFS= read -r ln; do
    if (( first )); then printf '%s\n' "$ln"; first=0; else printf '  %s\n' "$ln"; fi
  done
  if [[ -n ${out:-} ]]; then
    printf '%s\n' "$out" | wrap_lines "$((GM_TERM_COLS - 8))" | while IFS= read -r ln; do
      printf '\033[2m  ⎿ %s\033[0m\n' "$ln"
    done
  fi
  printf '\n'
}

render_messages() { # sid -> 角色标记行
  local sid=$1 esc db=$GM_OPENCODE_DB
  esc=${sid//\'/\'\'}
  sqlite3 -readonly "$db" \
    "select json_object('seq',seq,'type',type,'data',json(data))
       from session_message
      where session_id='$esc'
      order by seq desc limit 40;" 2>/dev/null \
  | jq -s -r '
    reverse[] as $m | ($m.data // {}) as $d |
    if $m.type == "user" then
      (($d.text // "") | gsub("\t"; "  ") | split("\n")[]) | "U\t" + .
    elif $m.type == "assistant" then
      (($d.content // [])[]) as $p |
      if $p.type == "text" then
        (($p.text // "") | gsub("\t"; "  ") | split("\n")[]) | "A\t" + .
      elif $p.type == "reasoning" then
        (($p.text // "") | gsub("\t"; "  ") | split("\n")) as $L |
        ($L | length) as $n |
        ($L | .[(if $n > 8 then $n - 8 else 0 end):][:8][]) | "R\t" + (if . == "" then " " else . end)
      elif $p.type == "tool" then
        (($p.state.input.command // $p.state.input.filePath // $p.state.input.pattern
          // $p.state.input.url // ($p.state.input | tostring))
          | tostring | gsub("\t"; " ") | gsub("\n"; " ") | .[0:260]) as $arg |
        (($p.state.content // []) | map(select(.type == "text") | (.text // ""))
          | join(" ⏎ ") | gsub("\t"; " ") | gsub("\n"; " ⏎ ") | .[0:400]) as $out |
        "T\t" + ($p.name // "tool") + "\t" + ($p.state.status // "?") + "\t" + $arg + "\t" + $out
      else empty end
    elif $m.type == "idle" then
      "I\t" + ($d.outcome // "")
    elif $m.type == "system" then
      "S\t" + (($d.text // ($d | tostring)) | tostring | .[0:300])
    elif $m.type == "compaction" then
      "C\t" + (($d | tostring) | .[0:200])
    elif $m.type == "synthetic" then
      "S\t" + (($d | tostring) | .[0:300])
    else empty end
  ' 2>/dev/null
}

render() { # status model card elapsed active sid code
  local status=$1 model=$2 card=$3 elapsed=$4 active=$5 sid=$6 code=$7
  local state_text color

  if (( active )); then
    state_text="运行中"; color='1;32'
  elif [[ $status == done ]]; then
    state_text="已完成"; color='1;36'
  else
    state_text="失败($status)"; color='1;31'
  fi

  printf '\033]0;%s · %s\033\\' "$(gm_cut "${card_disp:-${card:-会话}}" 34)" "$(gm_cut "${model:-}" 22)"
  : > "$HEADF"
  printf '\033[7m \033[1m%s\033[0m \033[7m %s \033[0m\n' "$(gm_ell "$card_disp" $((GM_TERM_COLS - 12)))" "$ID" >> "$HEADF"
  if (( GM_TERM_COLS >= 55 )); then
    local agent_txt=""
    [[ -n ${AGENT:-} ]] && agent_txt=" · $(gm_ell "$AGENT" 14)"
    if (( active )); then
      printf '\033[%sm● %s\033[0m · %s%s · %s · tok %s · 消息 %s\n' \
        "$color" "$state_text" "$(gm_ell "$model" 22)" "$agent_txt" "$(gm_fmt_dur "$elapsed")" "${TOK:-—}" "${MSGS:-—}" >> "$HEADF"
    else
      printf '\033[%sm%s\033[0m · %s%s · 用时 %s · exit %s\n' \
        "$color" "$state_text" "$(gm_ell "$model" 18)" "$agent_txt" "$(gm_fmt_dur "$elapsed")" "${code:--}" >> "$HEADF"
    fi
  else
    if (( active )); then
      printf '\033[%sm● %s\033[0m · %s · tok %s\n' \
        "$color" "$state_text" "$(gm_fmt_dur "$elapsed")" "${TOK:-—}" >> "$HEADF"
    else
      printf '\033[%sm%s\033[0m · 用时 %s · exit %s\n' \
        "$color" "$state_text" "$(gm_fmt_dur "$elapsed")" "${code:--}" >> "$HEADF"
    fi
  fi
  printf '\033[2m%s\033[0m\n' "$(printf '─%.0s' $(seq 1 $((GM_TERM_COLS - 2))))" >> "$HEADF"

  : > "$BODYF"
  flush_r() {
    [[ -n ${1:-} ]] || return 0
    printf '\033[2m◈ 思考流（最近）\033[0m\n' >> "$BODYF"
    printf '%s' "$1" >> "$BODYF"
    printf '\n' >> "$BODYF"
  }
  local rbuf=""
  { render_messages "$sid"; printf 'X\t\n'; } | while IFS=$'\t' read -r kind a b c d; do
    if [[ $kind == R ]]; then rbuf="${rbuf}${a}"$'\n'; continue; fi
    flush_r "$rbuf"; rbuf=""
    case $kind in
      U) emit_text "用户" "1;34" "$a" ;;
      A) emit_text "助手" "1;32" "$a" ;;
      T) emit_tool "$a" "$b" "$c" "$d" ;;
      I) emit_dim "… 等待（${a:-idle}）" ;;
      S) emit_dim "$a" ;;
      C) emit_dim "（上下文压缩）$a" ;;
    esac
  done >> "$BODYF"

  : > "$BUF"
  cat "$HEADF" >> "$BUF"
  if [[ -s $BODYF ]]; then
    tail -n "$BODY_LINES" "$BODYF" >> "$BUF"
  else
    {
      printf '\033[2m  等待 opencode 会话建立…（日志实时预览）\033[0m\n\n'
      [[ -f $LOG ]] && tail -n "$((BODY_LINES - 2))" "$LOG"
    } >> "$BUF"
  fi
  printf '\033[2m%s\033[0m\n' "$(printf '─%.0s' $(seq 1 $((GM_TERM_COLS - 2))))" >> "$BUF"
  if (( active )); then
    printf '\033[2m跟随中 · %s · %s\033[0m' "$(date '+%H:%M:%S')" "$([[ -n $sid ]] && echo "ses ${sid: -8}" || echo '无会话')" >> "$BUF"
  else
    printf '\033[2mrun 已结束，pane 即将关闭 · %s\033[0m' "$(date '+%H:%M:%S')" >> "$BUF"
  fi

  # 帧整形：ANSI 颜色不计宽，每行显示宽度 ≤ W-2、帧高 ≤ H-1 → 头两行永久固定
  python3 -c '
import sys, re
W = int(sys.argv[1]); H = int(sys.argv[2])
ANSI = re.compile(r"\x1b\[[0-9;]*[A-Za-z]|\x1b\][^\x07]*(?:\x07|\x1b\\)")
def vis(s):
    return ANSI.sub("", s)
def dw(s):
    t = 0
    for c in vis(s):
        o = ord(c)
        if (11904 <= o <= 12350) or (12353 <= o <= 13311) or (13312 <= o <= 19903) or (19968 <= o <= 40959) or (63744 <= o <= 64255) or (65280 <= o <= 65376) or (65504 <= o <= 65510) or (4352 <= o <= 4447) or o >= 131072:
            t += 2
        else:
            t += 1
    return t
def cut(s, w):
    out = ""; width = 0; i = 0; n = len(s)
    while i < n:
        if s[i] == "\x1b":
            m = ANSI.match(s, i)
            if m:
                out += m.group(0); i = m.end(); continue
        c = s[i]
        cw = 2 if (lambda o: (11904 <= o <= 12350) or (12353 <= o <= 13311) or (13312 <= o <= 19903) or (19968 <= o <= 40959) or (63744 <= o <= 64255) or (65280 <= o <= 65376) or (65504 <= o <= 65510) or (4352 <= o <= 4447) or o >= 131072)(ord(c)) else 1
        if width + cw > w:
            break
        out += c; width += cw; i += 1
    return out
lines = sys.stdin.read().splitlines()
for l in lines[:max(1, H - 1)]:
    print(cut(l, W - 2))
' "$GM_TERM_COLS" "$GM_TERM_LINES" < "$BUF" > "$BUF.fit" 2>/dev/null && mv -f "$BUF.fit" "$BUF"
  # 无闪烁重绘：逐行刷新，不清屏
  printf '\033[H'
  sed $'s/$/\\x1b[K/' "$BUF"
  printf '\033[J'
  sed $'s/\033\\[[0-9;]*m//g; s/\033\\][^\a]*\a//g' "$BUF" > "$SNAP.new.$$" 2>/dev/null \
    && mv -f "$SNAP.new.$$" "$SNAP" 2>/dev/null
}

while :; do
  if [[ ! -f $REG ]]; then
    printf '\033[H\033[2J该 run 已从注册表移除（%s），pane 即将关闭。\n' "$ID"
    sleep 1
    exit 0
  fi

  IFS=$'\t' read -r status model card logf pid started cwd code <<<"$(
    jq -r '[.status // "unknown", .model // "-",
            ((.card // .id // "-") | if . == "" then "-" else . end),
            ((.log // "-") | if . == "" then "-" else . end),
            (.pid // 0 | tostring), (.started // 0 | tostring),
            ((.cwd // "-") | if . == "" then "-" else . end),
            (.exit // 0 | tostring)] | @tsv' "$REG" 2>/dev/null
  )"
  LOG=${logf:-}
  started=${started:-0}; pid=${pid:-0}; code=${code:-0}
  gm_term_size
  BODY_LINES=$((GM_TERM_LINES - 6))
  (( BODY_LINES < 4 )) && BODY_LINES=4

  active=0
  sid_db=$(gm_run_get "$REG" .session "" 2>/dev/null)
  if [[ -n $sid_db && "$pid" == 0 ]]; then
    # DB 自动发现模式：会话 150 秒内有更新 = 运行中
    fresh=$(sqlite3 -readonly "$GM_OPENCODE_DB" "select case when time_updated >= $(( ($(gm_now) - 150) * 1000 )) then 1 else 0 end from session_v2 where id='$sid_db';" 2>/dev/null)
    [[ $fresh == 1 ]] && active=1
  elif [[ $status == running ]] && gm_alive "$pid"; then
    active=1
  fi

  sid=""
  [[ -s $SIDFILE ]] && sid=$(cat "$SIDFILE" 2>/dev/null)
  if [[ -z $sid ]]; then
    sid=$(gm_session_for_registry "$REG" 2>/dev/null) || sid=""
  fi

  now=$(gm_now)
  if (( now - TOK_AT >= 5 )); then
    TOK_AT=$now
    if [[ -n $sid ]]; then
      if t=$(gm_session_tokens_sid "$sid"); then TOK=$(gm_fmt_tokens "$t"); else TOK=""; fi
      esc=${sid//\'/\'\'}
      MSGS=$(sqlite3 -readonly "$GM_OPENCODE_DB" "select count(*) from session_message where session_id='$esc';" 2>/dev/null)
      # Agent 与标题（卡片名为空时回退到会话标题/首条用户提示词）
      IFS=$'\t' read -r STITLE AGENT <<<"$(sqlite3 -readonly "$GM_OPENCODE_DB" "select coalesce(title,'-')||char(9)||coalesce(agent,'-') from session_v2 where id='$esc';" 2>/dev/null)"
      if [[ ${STITLE:-} == "-" ]]; then STITLE=""; fi
      if [[ ${AGENT:-} == "-" ]]; then AGENT=""; fi
      if [[ -z ${STITLE:-} ]]; then
        STITLE=$(sqlite3 -readonly "$GM_OPENCODE_DB" "select replace(replace(replace(coalesce(json_extract(data,'$.text'),''),char(34),''),char(10),' '),char(9),' ') from session_message where session_id='$esc' and type='user' order by seq limit 1;" 2>/dev/null | cut -c1-36)
      fi
    else
      TOK=""; MSGS=""
    fi
  fi

  elapsed=$(( $(gm_now) - started )); (( elapsed < 0 )) && elapsed=0

  card_disp=$(gm_cut "${card:-}" 44)
  [[ -z ${card_disp//[[:space:]]/} ]] && card_disp="${STITLE:-opencode 会话}"

  if (( active )); then
    touch "$HB"
    render "$status" "$model" "$card" "$elapsed" 1 "$sid" "$code"
    printf '%s %s\n' "$GM_TERM_COLS" "$GM_TERM_LINES" > "$GM_STATE/size-$ID.txt" 2>/dev/null
    sleep 1
  else
    render "$status" "$model" "$card" "$elapsed" 0 "$sid" "$code"
    printf '%s %s\n' "$GM_TERM_COLS" "$GM_TERM_LINES" > "$GM_STATE/size-$ID.txt" 2>/dev/null
    rm -f "$HB"
    sleep 0.3
    exit 0
  fi
done
